  "implementation_order": [
    {
      "phase": 1,
      "name": "Scaffold e Bootstrap",
      "priority": "CRÍTICO",
      "estimated_time": "2-4 horas",
      "deliverable": "Frontend branco em localhost:5173 + backend respondendo em localhost:3001",
      "steps": [
        "Criar monorepo com frontend/ e backend/",
        "Executar install_command do frontend e do backend",
        "Configurar tsconfig.json em ambos os pacotes",
        "Criar vite.config.ts com proxy /api e /ws (conteúdo em vite_config.content)",
        "Criar backend/src/server.ts com Express + CORS básico na porta 3001",
        "Criar backend/.env com base em environment_variables.env_example_content",
        "Verificar que ambos sobem sem erros de compilação"
      ]
    },
    {
      "phase": 2,
      "name": "Backend Core — Filesystem e Terminal",
      "priority": "CRÍTICO",
      "estimated_time": "4-6 horas",
      "deliverable": "GET /api/files retorna FileNode[]; terminal WS responde",
      "steps": [
        "Implementar FileService.ts — funções listadas em filesystem_real_operations.functions com greenforge_equivalent",
        "Implementar routes/files.ts — endpoints listados em filesystem.greenforge_file_service_contract.endpoints",
        "Implementar WatcherService.ts (Chokidar com ignoreInitial: true)",
        "Implementar wsServer.ts (ws.Server sobre o http.Server do Express — mesma porta 3001)",
        "Implementar fileWatchHandler.ts (broadcast file.change|create|delete via WS)",
        "Implementar TerminalService.ts (node-pty spawn/resize/kill com cwd=WORKSPACE_ROOT)",
        "Implementar terminalHandler.ts (bridge WS ↔ node-pty usando protocolo em terminal.message_protocol)",
        "Implementar config.ts (carregar .env e exportar constantes)"
      ]
    },
    {
      "phase": 3,
      "name": "Frontend Core — Editor, Explorer, Terminal",
      "priority": "CRÍTICO",
      "estimated_time": "6-8 horas",
      "deliverable": "Clicar em arquivo abre no Monaco; terminal funciona; árvore atualiza em tempo real",
      "steps": [
        "Implementar types/ usando interfaces em interfaces.greenforge_additions",
        "Implementar editorStore.ts e fileStore.ts (Zustand com persist middleware)",
        "Implementar services/api.ts (axios com base URL localhost:3001/api)",
        "Implementar services/wsClient.ts (singleton WebSocket em ws://localhost:3001/ws)",
        "Implementar Layout.tsx (flex row: Sidebar 280px | Editor flex-1 | AgentPanel 320px)",
        "Implementar FileTree.tsx + FileTreeNode.tsx (GET /api/files ao montar + WS updates)",
        "Implementar EditorTabs.tsx (tabs com X, persistência localStorage)",
        "Implementar CodeEditor.tsx (@monaco-editor/react com config em editor.initialization_pattern.minimum_working_config)",
        "Implementar Terminal.tsx usando sequência em terminal.initialization_pattern",
        "Wiring: FileTree click → editorStore.openTab() → CodeEditor render"
      ]
    },
    {
      "phase": 4,
      "name": "Integração de Agentes — Camada Básica",
      "priority": "ALTO",
      "estimated_time": "4-6 horas",
      "deliverable": "Agente lê e escreve arquivos via chat; streaming visível token a token",
      "steps": [
        "Implementar LLMAdapter.ts (interface em ai_integration.greenforge_replacement.interface)",
        "Implementar AgentTools.ts (tool definitions em ai_integration.greenforge_replacement.tool_definitions)",
        "Implementar AgentService.ts (loop: LLM → detecta tool call → executa → retorna → LLM)",
        "Implementar agentHandler.ts (WS handler para agent.message do cliente)",
        "Implementar agentStore.ts (Zustand: messages, status, streaming)",
        "Implementar AgentChat.tsx (input + histórico + streaming delta)",
        "Wiring: AgentChat → WS → AgentService → AgentTools → FileService"
      ]
    },
    {
      "phase": 5,
      "name": "Approval e Diff — Gates HITL",
      "priority": "ALTO",
      "estimated_time": "3-4 horas",
      "deliverable": "Agente tenta escrever → ApprovalCard com diff → aprovação → arquivo salvo",
      "steps": [
        "Implementar DiffEditor.tsx (DiffEditor do @monaco-editor/react — original vs proposto)",
        "Implementar ApprovalCard.tsx (modal/overlay com DiffEditor + Aprovar/Rejeitar/Editar)",
        "Interceptar write_file em AgentTools.ts para emitir approval.request via WS antes de escrever",
        "Wiring: approval.request → ApprovalCard renderiza → usuário clica → approval.response WS",
        "Wiring: approved=true → FileService.write() + WALService.log()"
      ]
    },
